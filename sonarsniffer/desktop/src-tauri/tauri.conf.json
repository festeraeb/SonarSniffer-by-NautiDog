{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonarSniffer",
  "version": "0.8.15",
  "identifier": "com.nautidog.sonarsniffer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SonarSniffer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "resources": [],
    "externalBin": [
      "binaries/soundtiles",
      "binaries/sonarsniffer-cli",
      "binaries/parse_cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}