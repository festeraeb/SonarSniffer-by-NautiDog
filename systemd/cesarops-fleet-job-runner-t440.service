[Unit]
Description=CESAROPS fleet job runner — T440 queue (run on cesarops2 when T440 is down)
After=network-online.target remote-fs.target

[Service]
Type=oneshot
User=cesarops
Environment=FLEET_NODE=t440
Environment=REPO=/mnt/t440/repo
Environment=CESAROPS_REPO=/mnt/t440/repo
ExecStart=/mnt/t440/repo/scripts/fleet-job-runner.sh
