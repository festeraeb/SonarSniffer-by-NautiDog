# Source on cesarops2 to stay local — do not disturb T440 (Zaya / P100 work).
#   source /mnt/t440/codebase/repos/wreckhunter2000-1/scripts/cesarops2-isolated.env
#
export CESAROPS2_ISOLATED=1
export NAUTI_AVOID_P100=1

# Forge / NautiInferer — local only (never default to T440 :9100)
export FORGE_URL=http://127.0.0.1:9100
export FORGE_V2_DIR="${FORGE_V2_DIR:-/mnt/t440/codebase/repos/wreckhunter2000-1/cesarops-forge-v2}"
export NAUTI_LISTEN_PORT=8099

# Fleet jobs: only enqueue to cesarops2, never t440
export FLEET_DISPATCH=nfs
export FLEET_NODES_ALLOWED=cesarops2,t440

# Writable paths on the 1.8T system disk (/), NOT the small full /data partition (~481G sdc).
#   /          ~1.4T free  — home, HF hub, cesarops-data (default)
#   /data      ~0 free     — legacy; 359G+ models (do not add here)
#   /mnt/data-external/cesarops — T440 NFS ~1.1T free (optional mirror)
export CESAROPS_DATA_ROOT="${CESAROPS_DATA_ROOT:-$HOME/cesarops-data}"
export MODELS="${MODELS:-$CESAROPS_DATA_ROOT/models}"
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

# Cake: c2-only; no cluster discovery to T440 workers
export CAKE_C2_ONLY=0
export SKIP_T440=0
export SKIP_P100=0

# LLM endpoints (edge routing — local llama only)
export QWEN_URL=http://127.0.0.1:5200/v1/chat/completions
export GEMMA_URL=http://127.0.0.1:5571/v1/chat/completions
