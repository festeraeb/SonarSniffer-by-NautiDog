[Unit]
Description=CESAROPS Forge v2 - Self-Healing Knowledge Translator
After=network.target koboldcpp.service nautivecs-server.service
Wants=koboldcpp.service nautivecs-server.service deepseek-r1-xeon.service

[Service]
Type=simple
User=cesarops
WorkingDirectory=/codebase/wreckhunter2000-1/cesarops-forge-v2
Environment=RUST_LOG=cesarops_forge_v2=info
ExecStart=/codebase/wreckhunter2000-1/cesarops-forge-v2/target/release/cesarops-forge-v2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cesarops-forge-v2

[Install]
WantedBy=multi-user.target
