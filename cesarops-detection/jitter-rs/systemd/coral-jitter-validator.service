[Unit]
Description=Coral Edge TPU jitter validator (jitter-rs remote)
After=network.target

[Service]
Type=simple
User=cesarops
Group=plugdev
Environment=CORAL_PORT=8190
Environment=CORAL_MODEL=/opt/cesarops/models/jitter_edgetpu.tflite
Environment=CORAL_VENV=/opt/cesarops/venvs/coral-jitter
Environment=REPO=/codebase/repos/wreckhunter2000-1
ExecStart=/opt/cesarops/venvs/coral-jitter/bin/python /codebase/repos/wreckhunter2000-1/cesarops-detection/jitter-rs/coral_jitter_worker.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
