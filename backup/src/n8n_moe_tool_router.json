{
  "name": "MoE Tool Call Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tool-route",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "tool-route"
    },
    {
      "parameters": {
        "jsCode": "// Normalize raw LLM tool call output\n// Handles: <tool_call>JSON</tool_call>, naked JSON, markdown-wrapped JSON\n\nconst raw = $input.first().json.body?.raw_output || $input.first().json.body?.text || '';\nlet toolCall = null;\n\n// Try <tool_call> tags\nconst tagMatch = raw.match(/<tool_call>\\s*([\\s\\S]*?)\\s*<\\/tool_call>/);\nif (tagMatch) {\n  try { toolCall = JSON.parse(tagMatch[1]); } catch(e) {}\n}\n\n// Try ```json blocks\nif (!toolCall) {\n  const codeMatch = raw.match(/```(?:json)?\\s*({[\\s\\S]*?})\\s*```/);\n  if (codeMatch) {\n    try { toolCall = JSON.parse(codeMatch[1]); } catch(e) {}\n  }\n}\n\n// Try naked JSON with \"name\" key\nif (!toolCall) {\n  const jsonMatch = raw.match(/({\\s*\"name\"[\\s\\S]*?}\\s*})/);\n  if (jsonMatch) {\n    try { toolCall = JSON.parse(jsonMatch[1]); } catch(e) {}\n  }\n}\n\nif (toolCall && toolCall.name) {\n  return [{ json: { status: 'parsed', tool_name: toolCall.name, arguments: toolCall.arguments || {}, raw_output: raw } }];\n} else {\n  return [{ json: { status: 'no_tool_call', raw_output: raw } }];\n}"
      },
      "id": "parse-tool",
      "name": "Parse Tool Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            { "leftValue": "={{ $json.tool_name }}", "rightValue": "think_harder", "operator": { "type": "string", "operation": "equals" } }
          ]
        }
      },
      "id": "route-think",
      "name": "Is think_harder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:5003/query",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.arguments.query }}" },
            { "name": "top_k", "value": "5" }
          ]
        },
        "options": { "timeout": 10000 }
      },
      "id": "nautivecs-query",
      "name": "Query Nautivecs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [920, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            { "leftValue": "={{ $json.tool_name }}", "rightValue": "read_file", "operator": { "type": "string", "operation": "equals" } }
          ]
        }
      },
      "id": "route-file",
      "name": "Is read_file?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "command": "={{ 'cat /codebase/repos/wreckhunter2000-1/' + $json.arguments.path }}"
      },
      "id": "exec-read-file",
      "name": "Read File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [920, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            { "leftValue": "={{ $json.tool_name }}", "rightValue": "run_command", "operator": { "type": "string", "operation": "equals" } }
          ]
        }
      },
      "id": "route-cmd",
      "name": "Is run_command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 600]
    },
    {
      "parameters": {
        "command": "={{ $json.arguments.cmd }}"
      },
      "id": "exec-command",
      "name": "Run Command",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [920, 600]
    },
    {
      "parameters": {
        "jsCode": "// Format tool result back for the LLM\nconst toolName = $('Parse Tool Call').first().json.tool_name;\nconst result = $input.first().json.stdout || $input.first().json.data || JSON.stringify($input.first().json);\n\nconst truncated = result.length > 3000 ? result.substring(0, 3000) + '...[truncated]' : result;\n\nreturn [{ json: { tool_name: toolName, result: truncated, status: 'success' } }];"
      },
      "id": "format-result",
      "name": "Format Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1400, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Parse Tool Call", "type": "main", "index": 0 }]] },
    "Parse Tool Call": { "main": [[{ "node": "Is think_harder?", "type": "main", "index": 0 }, { "node": "Is read_file?", "type": "main", "index": 0 }, { "node": "Is run_command?", "type": "main", "index": 0 }]] },
    "Is think_harder?": { "main": [[{ "node": "Query Nautivecs", "type": "main", "index": 0 }], []] },
    "Query Nautivecs": { "main": [[{ "node": "Format Result", "type": "main", "index": 0 }]] },
    "Is read_file?": { "main": [[{ "node": "Read File", "type": "main", "index": 0 }], []] },
    "Read File": { "main": [[{ "node": "Format Result", "type": "main", "index": 0 }]] },
    "Is run_command?": { "main": [[{ "node": "Run Command", "type": "main", "index": 0 }], []] },
    "Run Command": { "main": [[{ "node": "Format Result", "type": "main", "index": 0 }]] },
    "Format Result": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
