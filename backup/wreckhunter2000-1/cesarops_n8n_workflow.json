    {
      "parameters": {
        "command": "cd /home/node/.n8n/cesarops-slicer && cargo run --release --bin thermal_specialist -- --bbox -88.0,42.0,-87.0,43.0"
      },
      "id": "cf64a754-523c-42b6-aae7-caef978ea0ba",
